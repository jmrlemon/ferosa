<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background. Full bleed on purpose: the launcher masks this to
  whatever shape the device uses, so anything that does not reach the edges
  would show the mask's own background at the corners.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF2E7D57" />
                <item android:offset="1" android:color="#FF1B5239" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
