<?xml version="1.0" encoding="utf-8"?>
<!--
  Ferosa leaf mark. The artwork is authored on a 24x24 grid (the Material icon
  grid) and scaled into the 108x108 adaptive-icon viewport by the group below.
  With pivot 0 the transform is `28 + 2.1667 * p`, mapping the artwork to
  28..80 - inside the 66dp safe zone that every launcher mask is guaranteed to
  keep, so the leaf is never clipped on a circle, squircle or teardrop mask.

  This drawable is also used as the <monochrome> layer, where the system
  replaces the fill, so the shape has to read on its own without the colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="0"
        android:pivotY="0"
        android:scaleX="2.1667"
        android:scaleY="2.1667"
        android:translateX="28"
        android:translateY="28">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M6.05,8.05c-2.73,2.73 -2.73,7.15 -0.02,9.88 1.47,-3.4 4.09,-6.24 7.36,-7.93 -2.77,2.34 -4.71,5.61 -5.39,9.32 2.6,1.23 5.8,0.78 7.95,-1.37C19.43,14.47 20,4 20,4S9.53,4.57 6.05,8.05z" />
    </group>
</vector>
